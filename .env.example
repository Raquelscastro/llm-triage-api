LLM_PROVIDER=fake

# Chave do Gemini. Pegue em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20

# Senha do Postgres (usada pelo docker compose). Use só letras e números.
POSTGRES_PASSWORD=

# Endereço do banco. Troque SUA_SENHA pela mesma senha acima.
DATABASE_URL=postgresql+psycopg://triage_user:SUA_SENHA@127.0.0.1:5434/triage_db